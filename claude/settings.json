{
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline-command.js"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "theme": "dark",
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/wmux-md.js --hook",
            "async": true
          }
        ]
      }
    ]
  }
}
